{
  "name": "dubai-proptech-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dubai-focused whitelabel property maintenance platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker:outbox": "tsx src/workers/outbox-relay.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test src/app.test.ts src/domain.test.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-raw-body": "^5.0.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
